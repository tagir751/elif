generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  roles        String   // JSON array: ["manager"], ["teacher"], ["manager","teacher"], ["admin"]
  status       String   @default("active")
  deletedAt    DateTime?
  createdAt    DateTime @default(now())

  teacher   Teacher?
  auditLogs AuditLog[]
  tasks     Task[]

  @@map("users")
}

model Teacher {
  id             String   @id @default(uuid())
  userId         String   @unique
  fullName       String
  specialization String
  phone          String
  status         String   @default("active")
  deletedAt      DateTime?
  createdAt      DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id])
  groups       Group[]
  lessons      Lesson[]
  observations Observation[]

  @@map("teachers")
}

model Student {
  id        String   @id @default(uuid())
  firstName String
  lastName  String
  birthDate DateTime?
  phone     String?
  familyId  String
  status    String   @default("active")
  deletedAt DateTime?
  createdAt DateTime @default(now())

  family       Family        @relation(fields: [familyId], references: [id])
  enrollments  Enrollment[]
  attendances  Attendance[]
  observations Observation[]

  @@map("students")
}

model Family {
  id         String   @id @default(uuid())
  name       String
  phone      String
  email      String?
  telegram   String?
  monthlyFee Int      @default(0)
  paidUntil  DateTime?
  comment    String?
  deletedAt  DateTime?
  createdAt  DateTime @default(now())

  students Student[]
  payments Payment[]

  @@map("families")
}

model Payment {
  id        String   @id @default(uuid())
  familyId  String
  amount    Int
  date      DateTime
  comment   String?
  createdAt DateTime @default(now())

  family Family @relation(fields: [familyId], references: [id])

  @@map("payments")
}

model Group {
  id        String   @id @default(uuid())
  name      String
  subject   String
  teacherId String
  roomId    String
  capacity  Int
  status    String   @default("active")
  deletedAt DateTime?
  createdAt DateTime @default(now())

  teacher       Teacher        @relation(fields: [teacherId], references: [id])
  room          Room           @relation(fields: [roomId], references: [id])
  enrollments   Enrollment[]
  scheduleSlots ScheduleSlot[]
  lessons       Lesson[]

  @@map("groups")
}

model Enrollment {
  id        String   @id @default(uuid())
  studentId String
  groupId   String
  startDate DateTime
  endDate   DateTime?
  status    String   @default("active")
  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id])
  group   Group   @relation(fields: [groupId], references: [id])

  @@map("enrollments")
}

model ScheduleSlot {
  id              String   @id @default(uuid())
  groupId         String
  dayOfWeek       Int      // 1=Mon, 2=Tue, ..., 7=Sun
  timeStart       String   // "17:00"
  durationMinutes Int      @default(90)
  roomId          String
  createdAt       DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id])
  room  Room  @relation(fields: [roomId], references: [id])

  @@map("schedule_slots")
}

model Lesson {
  id            String   @id @default(uuid())
  groupId       String
  teacherId     String
  roomId        String
  dateTime      DateTime
  status          String   @default("planned") // planned, completed, cancelled, conflict
  conflictDetails String?  // JSON: [{ type: 'TEACHER_BUSY'|'ROOM_BUSY', description, conflictingLessonId }]
  topic           String?  // тема урока
  homework      String?  // домашнее задание
  lessonNote    String?  // заметка по уроку
  hypothesis    String?  // гипотеза на следующее занятие
  personalNote  String?  // личная заметка педагога
  createdAt DateTime @default(now())

  group       Group        @relation(fields: [groupId], references: [id])
  teacher     Teacher      @relation(fields: [teacherId], references: [id])
  room        Room         @relation(fields: [roomId], references: [id])
  attendances Attendance[]
  observations Observation[]

  @@unique([groupId, dateTime, teacherId, roomId])
  @@map("lessons")
}

model Attendance {
  id        String   @id @default(uuid())
  lessonId  String
  studentId String
  status    String   // present, absent, late
  mark      String?  // 5, 4, 3, 2, Н
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lesson  Lesson  @relation(fields: [lessonId], references: [id])
  student Student @relation(fields: [studentId], references: [id])

  @@unique([lessonId, studentId])
  @@map("attendances")
}

model Observation {
  id        String   @id @default(uuid())
  studentId String
  lessonId  String
  teacherId String
  text      String
  status    String   @default("draft") // draft, published, archived
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id])
  lesson  Lesson  @relation(fields: [lessonId], references: [id])
  teacher Teacher @relation(fields: [teacherId], references: [id])
  versions ObservationVersion[]

  @@map("observations")
}

model ObservationVersion {
  id            String   @id @default(uuid())
  observationId String
  text          String
  version       Int
  createdAt     DateTime @default(now())

  observation Observation @relation(fields: [observationId], references: [id], onDelete: Cascade)

  @@unique([observationId, version])
  @@map("observation_versions")
}

model Room {
  id        String   @id @default(uuid())
  name      String
  address   String?
  capacity  Int
  equipment String?
  deletedAt DateTime?
  createdAt DateTime @default(now())

  groups        Group[]
  scheduleSlots ScheduleSlot[]
  lessons       Lesson[]

  @@map("rooms")
}

model Task {
  id        String   @id @default(uuid())
  title     String
  type      String   // call, meeting, finance, schedule, student, documents, other
  bucket    String   // today, later, waiting
  dueDate   DateTime?
  completed Boolean  @default(false)
  familyId  String?
  studentId String?
  createdBy String
  createdAt DateTime @default(now())

  user User @relation(fields: [createdBy], references: [id])

  @@map("tasks")
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String
  action      String   // create, update, delete
  entity      String
  entityId    String
  payloadJson String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model Recommendation {
  id         String   @id @default(uuid())
  teacherId  String?
  studentId  String?
  lessonId   String?
  text       String
  source     String   @default("AI") // "AI" или "manual"
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@map("recommendations")
}

model Subject {
  id   String @id @default(uuid())
  name String @unique

  @@map("subjects")
}
